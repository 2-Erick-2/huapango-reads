{
  "name": "huapango-reads",
  "private": true,
  "type": "module",
  "description": "Huapango +reads — plataforma de lectura digital de Editorial Huapango (SolidStart).",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "assets:pdf": "node scripts/assets/pdf-a-png.ts",
    "assets:portadas": "node scripts/assets/portadas.ts",
    "e2e:humo": "node scripts/e2e/humo.ts",
    "e2e:panel": "node scripts/e2e/panel.ts",
    "contenido:publicar": "node scripts/contenido/publicar.ts",
    "contenido:importar": "node scripts/ingesta/importar.ts",
    "contenido:inspeccionar": "node scripts/ingesta/inspeccionar.ts",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@fontsource-variable/newsreader": "5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@myriaddreamin/typst-ts-web-compiler": "0.7.0",
    "@myriaddreamin/typst.ts": "0.7.0",
    "@solidjs/meta": "0.29.4",
    "@solidjs/router": "1.0.0",
    "@solidjs/start": "2.0.6",
    "@supabase/supabase-js": "2.119.0",
    "nitro": "3.0.260903-beta",
    "pdf-lib": "1.17.1",
    "prosemirror-commands": "1.7.2",
    "prosemirror-history": "1.5.2",
    "prosemirror-keymap": "1.2.3",
    "prosemirror-model": "1.25.13",
    "prosemirror-state": "1.4.4",
    "prosemirror-view": "1.43.1",
    "solid-js": "1.9.17",
    "vite": "8.3.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "eslint-plugin-solid": "0.18.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "playwright-core": "1.65.1",
    "prettier": "3.9.10",
    "saxes": "6.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }

{
  "name": "huapango-reads",
  "private": true,
  "type": "module",
  "description": "Huapango +reads — plataforma de lectura digital de Editorial Huapango (SolidStart).",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",

    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@solidjs/meta": "0.29.4",
    "@solidjs/router": "1.0.0",
    "@solidjs/start": "2.0.6",
    "nitro": "3.0.260903-beta",
    "solid-js": "1.9.17",
    "vite": "8.3.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "eslint-plugin-solid": "0.18.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
